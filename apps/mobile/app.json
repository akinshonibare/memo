{
  "expo": {
    "name": "memo",
    "slug": "memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B1410",
      "bundleIdentifier": "com.akinshonibare.memo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "memo records voice notes so they can be transcribed.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B241A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akinshonibare.memo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "memo reads the photos you choose so it can describe them and pull out todos, events and ideas.",
          "cameraPermission": "memo takes photos you choose to capture as notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0B241A"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.akinshonibare.memo",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Today's events and todos from memo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "RecordWidget",
              "displayName": "Record",
              "description": "Start a voice note in one tap.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.akinshonibare.memo",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "disableAndroid": true
        }
      ],
      "./plugins/withAppIntents"
    ],
    "backgroundColor": "#0B1410",
    "extra": {
      "eas": {
        "projectId": "fb5218ca-c4c4-4ee2-b97d-0c38e4a7d58d"
      }
    },
    "owner": "akiin",
    "scheme": "memo"
  }
}
