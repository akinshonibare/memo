{
  "expo": {
    "name": "memo",
    "slug": "memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0B1410",
      "bundleIdentifier": "com.akinshonibare.memo",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "memo records voice notes so they can be transcribed.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B241A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.akinshonibare.memo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "memo records voice notes so they can be transcribed.",
          "enableBackgroundRecording": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "memo reads the photos you choose so it can describe them and pull out todos, events and ideas.",
          "cameraPermission": "memo takes photos you choose to capture as notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#0B241A"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.akinshonibare.memo",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Today",
              "description": "Today's events and todos from memo.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "RecordWidget",
              "displayName": "Record",
              "description": "Start a voice note in one tap.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "accessoryCircular"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-share-intent",
        {
          "iosAppGroupIdentifier": "group.com.akinshonibare.memo",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "disableAndroid": true
        }
      ],
      "./plugins/withAppIntents",
      "expo-asset",
      [
        "expo-calendar",
        {
          "calendarPermission": "memo keeps its events in a calendar called memo and keeps that calendar up to date. It never reads your own events.",
          "remindersPermission": "memo keeps its todos in a Reminders list called memo, and ticks off the ones you finish there."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "memo uses Face ID to lock your notes, if you turn that on."
        }
      ],
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "memo reads your workouts so they count towards your habits and it can notice milestones, like a first 10k. It never writes to Health.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "backgroundColor": "#0B1410",
    "extra": {
      "eas": {
        "projectId": "fb5218ca-c4c4-4ee2-b97d-0c38e4a7d58d"
      }
    },
    "owner": "akiin",
    "scheme": "memo",
    "updates": {
      "url": "https://u.expo.dev/fb5218ca-c4c4-4ee2-b97d-0c38e4a7d58d"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
