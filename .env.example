# --- application ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# The API and worker connect as memo_app so row-level security applies (ADR 0010).
DATABASE_URL=postgresql+asyncpg://memo_app:app-password@localhost:5433/memo
# Migrations connect as the owner. Never used on the request path.
DATABASE_ADMIN_URL=postgresql+asyncpg://memo:password@localhost:5433/memo
# Migration 0001 creates the memo_app role with this password.
APP_DB_PASSWORD=app-password
# Static bearer token gating every /v1 route (ADR 0018). Generate: openssl rand -hex 32
# Sign in with Apple (ADR 0019): the identity token's audience. Defaults to the app's
# bundle id; override only for a differently-signed build.
APPLE_BUNDLE_ID=com.akinshonibare.memo

# arq's broker. The product never reads job state from here (ADR 0012).
REDIS_URL=redis://localhost:6380/0

# Object storage for recordings. Locally this is the compose RustFS; on Railway, map
# these to the Bucket's ENDPOINT / BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / REGION.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=memo-recordings
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_REGION=auto
# "path" for a local store; leave unset ("auto") for Railway Buckets.
S3_ADDRESSING_STYLE=path

# Deepgram Nova-3 transcription (ADR 0013). Audio captures fail visibly without it.
DEEPGRAM_API_KEY=
# claude-opus-5 extraction (ADR 0014). Every capture fails at extract without it.
ANTHROPIC_API_KEY=
# voyage-4 embeddings (ADR 0016). Every capture fails at embed without it.
VOYAGE_API_KEY=
# Where that key is valid: keys from the Voyage dashboard (pa-…) use the default
# https://api.voyageai.com/v1/embeddings; keys minted in MongoDB Atlas (al-…) need
# https://ai.mongodb.com/v1/embeddings.
VOYAGE_API_URL=

# --- docker compose ------------------------------------------------------------
POSTGRES_USER=memo
POSTGRES_PASSWORD=password
POSTGRES_DB=memo
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
S3_HOST_PORT=9000
